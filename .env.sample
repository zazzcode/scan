# Copy to .env for local settings; .env is Git-ignored.
# Load trusted shell-compatible settings in bash/zsh:
#   set -a; . ./.env; set +a
# Existing .env? Merge settings into it rather than replacing your keys.

# Optional output root for --strings. Adjust to your local workspace layout.
# Each run writes <root>/<repo-name>/run-<id>/findings.{json,html,sarif}.
# --output-dir overrides this value; --output-dir "" disables file output.
SCAN_FINDINGS_DIR="$HOME/Dev/zazzcode/scan/_test-finding"

# Offline scans and exports do not need API credentials.
# Supply only the provider you explicitly choose with --judge.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
